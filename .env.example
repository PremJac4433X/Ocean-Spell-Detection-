# Ocean Guard AI - Environment Configuration Example
# Copy this file to .env and configure your secrets

# Backend Server Configuration
DEBUG=True
DATABASE_URL=sqlite:///./ocean_guard.db
DEMO_MODE=False

# API Authentication Credentials
# Generic API Key / Secret Token (e.g. for external services or microservices)
API_KEY=your_api_token_here

# Copernicus Data Space Ecosystem (Sentinel-1 SAR / Sentinel-2 imagery)
COPERNICUS_API_KEY=your_copernicus_token_here

# AISHub / AISStream (Real-time maritime vessel telemetry)
AIS_DATA_API_KEY=your_ais_token_here

# NOAA Marine Data (GFS & HYCOM ocean current/wind forecasting)
NOAA_API_KEY=your_noaa_token_here

# Mapbox Access Token (Public token for interactive GIS ocean map)
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

